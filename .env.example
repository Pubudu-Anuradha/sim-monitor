# Copy to .env (gitignored) and fill in. Used by `make dev` and `make deploy`.

# This desktop's fixed LAN IP: give it a DHCP reservation on your router. Phones connect to it,
# and it goes into the server's TLS certificate and the pairing QR code.
SIM_MONITOR_HOST=192.168.1.10

# Optional
# SIM_MONITOR_PORT=8000          # dashboard (always bound to 127.0.0.1)
# SIM_MONITOR_PHONE_PORT=8443    # phones (TLS)
# SIM_MONITOR_LOW_BALANCE=50     # highlight balances below this (Rs)
